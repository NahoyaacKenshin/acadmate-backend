generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  USER
  ADMIN
}

enum TokenType {
  REFRESH
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Models
model User {
  id               String        @id @default(uuid())
  email            String?       @unique
  password         String?
  name             String?
  emailVerified    DateTime?     @map("email_verified") // @map is custom table name
  programName      String?       @map("program_name")  // Set by student during onboarding
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  role             Role          @default(USER)
  tokens           Token[]
  subjects         Subject[]
  tasks            Task[]
  classSchedules   ClassSchedule[]
  calendarEvents   CalendarEvent[]
  examWeeks        ExamWeek[]
  semesterRules    SemesterRule[]
  notebooks        Notebook[]
  sources          Source[]
  chatSessions     ChatSession[]
}

model Token {
  id         String     @id @default(uuid())
  type       TokenType
  token      String     @unique
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  consumedAt DateTime?
  revokedAt  DateTime?

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  color       String?  @default("#3B82F6") // Default blue
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tasks            Task[]
  classSchedules   ClassSchedule[]
  calendarEvents   CalendarEvent[]
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

// ── Week 3: Calendar & Scheduler ────────────────────────────────────────────

enum Modality {
  F2F
  ONLINE
  HYBRID
}

enum SetType {
  A
  B
  BOTH
}

enum HolidayType {
  REGULAR
  SPECIAL
}

model ClassSchedule {
  id        String    @id @default(uuid())
  dayOfWeek Int       // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String    // "HH:MM" 24-hour format
  endTime   String    // "HH:MM" 24-hour format
  room      String?
  modality  Modality  @default(F2F)
  setType   SetType?  // null = every week, A = Set A weeks, B = Set B weeks
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?  // null = same-day event
  allDay      Boolean    @default(false)
  location    String?
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startDate])
}

model PhilippineHoliday {
  id   String      @id @default(uuid())
  date DateTime
  name String
  type HolidayType

  @@unique([date, name], name: "date_name")
  @@index([date])
}

model ExamWeek {
  id        String   @id @default(uuid())
  title     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Week 4: Admin System & Set A/B Scheduling Logic ──────────────────────────

enum StudentSet {
  A
  B
}

/// Student-defined custom modality override rules for alternating days.
/// Synced locally to the student's phone via PowerSync.
model SemesterRule {
  id        String     @id @default(uuid())
  startDate DateTime   // The start date this rule applies from
  endDate   DateTime?  // Optional end date this rule applies to
  dayOfWeek Int        // Day of week: 0 = Sun, 1 = Mon, 2 = Tue, 3 = Wed, 4 = Thu, 5 = Fri, 6 = Sat
  setType   StudentSet // A or B
  label     String?    // Optional human-readable label or note
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
}

// ── Week 5: AI Notebook & RAG Pipeline ────────────────────────────────────────

enum SourceFileType {
  PDF
  IMAGE
  TEXT
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A user-created notebook that groups uploaded study materials.
model Notebook {
  id          String        @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources      Source[]
  chatSessions ChatSession[]

  @@index([userId])
}

/// A single uploaded file (PDF, image, text) inside a Notebook.
model Source {
  id          String         @id @default(uuid())
  fileName    String
  fileType    SourceFileType
  storagePath String         // Supabase Storage object path
  status      SourceStatus   @default(PENDING)
  rawText     String?        // Extracted full text (populated after processing)
  errorMsg    String?        // Populated if status = FAILED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  notebookId String
  notebook   Notebook      @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks     SourceChunk[]

  @@index([notebookId])
  @@index([userId])
}

/// A single overlapping text chunk from a Source, with a pgvector embedding.
/// The `embedding` column uses the native pgvector type — stored as Unsupported
/// and queried via raw SQL ($queryRaw / $executeRaw).
model SourceChunk {
  id         String   @id @default(uuid())
  chunkIndex Int      // 0-based order within the source
  content    String   // Raw text of this chunk (~500 words)
  /// pgvector 768-dimensional embedding from Gemini text-embedding-004
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())

  sourceId   String
  source     Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  notebookId String

  @@index([sourceId])
  @@index([notebookId])
}

// ── Week 7: AI Chat & Conversation History ────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
}

/// A persisted AI chat session scoped to a specific notebook.
/// Each session groups a sequence of user/assistant message exchanges.
model ChatSession {
  id         String               @id @default(uuid())
  title      String?              // Derived from the first user message (truncated)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  notebookId String
  notebook   Notebook             @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessageHistory[]

  @@index([notebookId])
  @@index([userId])
}

/// A single message (user question or AI reply) within a ChatSession.
model ChatMessageHistory {
  id        String     @id @default(uuid())
  role      ChatRole   // USER or ASSISTANT
  content   String     // Message text
  citations Json?      // Serialized ChatCitation[] — null for user messages
  createdAt DateTime   @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
